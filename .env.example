# ===== MathMaster Edu 环境配置示例 =====
# 复制本文件为 .env 并按需修改；未配置 AI Key 时应用以演示模式运行

# ---------- AI 提供商 ----------
# openai_compatible = 任何 OpenAI 兼容服务（推荐，一套代码对接多家）
#   SiliconFlow:  https://api.siliconflow.cn/v1   模型示例: Qwen/Qwen2.5-VL-32B-Instruct
#   通义千问:      https://dashscope.aliyuncs.com/compatible-mode/v1  模型示例: qwen-vl-plus
#   智谱 GLM:     https://open.bigmodel.cn/api/paas/v4           模型示例: glm-4v-flash
#   DeepSeek / OpenAI / Ollama(http://localhost:11434/v1) 等同理
# gemini = Google Gemini（模型示例: gemini-2.0-flash）
# mock   = 演示模式（默认，无需 Key）
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# ---------- 数据库 ----------
# 默认 SQLite 零配置启动；切换 MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/math_tutor?charset=utf8mb4
# DATABASE_URL=

# ---------- 对象存储 ----------
# local = data_dir 本地磁盘（默认，开箱即用）
# s3    = S3 兼容对象存储（MinIO / 阿里云 OSS / 腾讯云 COS / AWS S3），需 pip install boto3
# MinIO 本地验证示例：
#   STORAGE_BACKEND=s3
#   S3_ENDPOINT=http://localhost:9000
#   S3_BUCKET=mathtutor
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin
# AWS S3 需另配 S3_REGION（如 us-east-1）；OSS/COS endpoint 换成对应外部端点即可
# STORAGE_BACKEND=local
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=mathtutor
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
# S3_PRESIGN_EXPIRES=3600

# ---------- RAG 向量检索 ----------
# 内置本地嵌入模型，开箱即用；如需更优中文检索效果可接远程嵌入：
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 重排（可选，混合检索精排）----------
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 每日复习目标（激励系统，v2.15+）----------
# 全局默认值；未在设置页自设目标的用户回退到该值（用户级目标存库后以此覆盖全局）。
# 取值范围 1-200，与 backend/config.py 的 DAILY_GOAL 字段同源。
# DAILY_GOAL=10

# ---------- 教师邀请码（教师自助注册，v2.22+）----------
# 留空 = 关闭教师自助注册；配置后注册教师必须携带匹配的 invite_code。
# 双语义：64 位 hex 视为 sha256 摘要（推荐：python -c "import hashlib;print(hashlib.sha256('你的邀请码'.encode()).hexdigest())"）；
# 其他非空值为明文比对（明文请避免 64-hex 字符串；非 ASCII 中文码安全）。轮换 = 改此值并重启。
# TEACHER_INVITE_CODE=

# ---------- 首次运行的种子账号 ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=demo123

# ---------- API 网关 (JWT) ----------
# 生产环境必须改为强随机密钥（>= 32 字节），例如：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# 令牌有效期（分钟），默认 7 天
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
